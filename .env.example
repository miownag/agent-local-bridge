BRIDGE_PUBLIC_URL=https://your-project.vercel.app
BRIDGE_ADMIN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
BRIDGE_WORKER_TOKEN=replace-with-a-different-random-secret-of-at-least-32-bytes
BRIDGE_NAMESPACE=agent-local-bridge-production
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-redis-rest-token
# Local development only: BRIDGE_DEV=1, BRIDGE_PUBLIC_URL=http://127.0.0.1:8787
